# Copy to backend/.env and fill in
PORT=3000

# Hosted Postgres (Neon etc.) - SSL is used automatically
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Local Postgres without SSL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rideshare?sslmode=disable

# Any long random string (keep it secret)
JWT_SECRET=change-me-to-a-long-random-string

# Optional
# ACCESS_TOKEN_EXPIRES=15m
# REFRESH_TOKEN_EXPIRES=30d
